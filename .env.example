# Gemini API key - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Single shared password to access the app
APP_PASSWORD=

# Secret for signing session cookies (min 32 chars, e.g. openssl rand -hex 32)
AUTH_SECRET=

# Secret for cron job endpoints (e.g. /api/cron/cat-decay)
CRON_SECRET=

# Server configuration
PORT=3000
HOSTNAME=0.0.0.0

# Postgres connection
# Note for Docker Compose deployment:
# - If using PostgreSQL container ('db' service in compose): postgresql://postgres:postgres@db:5432/english_summary
# - If using PostgreSQL on host machine: postgresql://postgres:postgres@host.docker.internal:5432/english_summary
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_summary
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_summary_test?schema=public

# Gemini Model configuration
GEMINI_MODEL=gemini-3.6-flash


